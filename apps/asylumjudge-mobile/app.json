{
  "expo": {
    "name": "AsylumJudge",
    "slug": "asylumjudge",
    "scheme": "asylumjudge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true, "reactCompiler": true },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asylumjudge.mobile"
    },
    "android": {
      "package": "com.asylumjudge.mobile",
      "predictiveBackGestureEnabled": true
    }
  }
}
