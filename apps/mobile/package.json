{
  "name": "trrb-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:auth": "node --experimental-strip-types --test src/auth/public-supabase-config.test.ts src/auth/unified-account.test.ts scripts/validate-auth-e2e-env.test.mjs scripts/cleanup-community-e2e.test.mjs",
    "test:community": "node --experimental-strip-types --test src/api/community-core.test.ts src/community/community-comment-like-state.test.ts src/community/community-comment-presentation.test.ts src/community/community-post-like-state.test.ts src/community/notification-core.test.ts src/storage/community-feed-cache-core.test.ts",
    "test:comments": "node --experimental-strip-types --test src/api/comment-like-state.test.ts src/community/comment-presentation.test.ts scripts/cleanup-news-comments-e2e.test.mjs",
    "test:library": "node --experimental-strip-types --test src/storage/article-cache-core.test.ts src/storage/article-translation-cache-core.test.ts src/storage/news-feed-cache-core.test.ts src/storage/legal-cache-core.test.ts src/storage/favorites-sync-core.test.ts src/storage/history-sync-core.test.ts src/storage/jobs-cache-core.test.ts src/storage/profile-post-draft-core.test.ts src/storage/community-post-draft-core.test.ts src/storage/comment-draft-core.test.ts src/storage/notification-cache-core.test.ts",
    "test:data-settings": "node --test scripts/validate-data-settings-integration.test.mjs scripts/validate-library-comments-data.test.mjs",
    "test:social": "node --test scripts/validate-social-profile.test.mjs",
    "test:push": "node --experimental-strip-types --test src/push/push-core.test.ts src/push/registration-core.test.ts src/push/registration-api.test.ts src/notifications/unread-core.test.ts src/notifications/notification-action-core.test.ts",
    "test:store-assets": "node --test scripts/store-submission-assets-core.test.mjs",
    "test:store-support": "node --test scripts/validate-store-support.test.mjs",
    "test:store-data": "node --test scripts/validate-store-data-practices.test.mjs",
    "test:store-review": "node --test scripts/validate-store-review-access.test.mjs",
    "test:store-release": "node --test scripts/store-release-preflight.test.mjs",
    "test:store-runbook": "node --test scripts/store-submission-plan.test.mjs",
    "test:store-build-evidence": "node --test scripts/store-build-evidence.test.mjs",
    "test:store-distribution-evidence": "node --test scripts/store-distribution-evidence.test.mjs",
    "test:store-device-acceptance": "node --test scripts/store-device-acceptance.test.mjs",
    "store:release-preflight": "node scripts/store-release-preflight.mjs",
    "store:release-preflight:strict": "node scripts/store-release-preflight.mjs --strict",
    "store:submission-plan": "node scripts/store-submission-plan.mjs",
    "store:build-evidence-check": "node scripts/store-build-evidence.mjs",
    "store:distribution-evidence-check": "node scripts/store-distribution-evidence.mjs",
    "store:device-acceptance-check": "node scripts/store-device-acceptance.mjs",
    "test:i18n": "node --experimental-strip-types --test src/i18n/i18n-core.test.ts src/jobs/job-presentation.test.ts scripts/validate-i18n-integration.test.mjs scripts/validate-search-accessibility.test.mjs scripts/validate-immigration-accessibility.test.mjs",
    "test:news-parity": "node --experimental-strip-types --test src/api/trrb-navigation.test.ts src/api/trrb-retry.test.ts src/components/news-image-retry-core.test.ts src/components/news-image-prefetch-core.test.ts src/components/news-page-request-core.test.ts scripts/validate-home-news-parity.test.mjs scripts/validate-news-feed-offline.test.mjs scripts/validate-america-recovery.test.mjs scripts/validate-legal-recovery.test.mjs scripts/validate-article-recovery.test.mjs",
    "typecheck": "tsc --noEmit",
    "config:check": "node ../../scripts/validate-mobile-store-config.mjs",
    "store:submission-check": "node scripts/validate-store-submission-assets.mjs",
    "export:web": "expo export --platform web --output-dir .expo-export --clear"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.15",
    "expo-linking": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.8",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
