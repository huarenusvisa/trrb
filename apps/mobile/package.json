{
  "name": "trrb-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:auth": "node --experimental-strip-types --test src/auth/public-supabase-config.test.ts src/auth/unified-account.test.ts scripts/validate-auth-e2e-env.test.mjs scripts/cleanup-community-e2e.test.mjs",
    "test:community": "node --experimental-strip-types --test src/api/community-core.test.ts",
    "test:comments": "node --experimental-strip-types --test src/community/comment-presentation.test.ts scripts/cleanup-news-comments-e2e.test.mjs",
    "test:library": "node --experimental-strip-types --test src/storage/favorites-sync-core.test.ts src/storage/history-sync-core.test.ts",
    "test:data-settings": "node --test scripts/validate-data-settings-integration.test.mjs",
    "test:push": "node --experimental-strip-types --test src/push/push-core.test.ts",
    "test:i18n": "node --experimental-strip-types --test src/i18n/i18n-core.test.ts scripts/validate-i18n-integration.test.mjs",
    "typecheck": "tsc --noEmit",
    "config:check": "node ../../scripts/validate-mobile-store-config.mjs",
    "export:web": "expo export --platform web --output-dir .expo-export --clear"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
